<mxCell id="44" value="R0 批量队列 · 短 Mutex&#xa;push：持锁 append 一批后解锁" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#fff2cc;strokeColor=#d6b656;spacing=8;" vertex="1" parent="38"><mxGeometry x="55" y="410" width="360" height="65" as="geometry"/></mxCell>
