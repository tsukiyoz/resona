<mxCell id="46" value="R0 唯一 worker&#xa;短暂持锁交换缓冲区，解锁后逐条处理" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=8;" vertex="1" parent="38"><mxGeometry x="55" y="550" width="360" height="80" as="geometry"/></mxCell>
