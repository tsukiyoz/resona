<mxCell id="48" value="空 → 非空时尝试通知&#xa;wake channel 容量 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#20252b;fillColor=none;strokeColor=none;spacing=4;align=left;" vertex="1" parent="38"><mxGeometry x="30" y="485" width="190" height="55" as="geometry"/></mxCell>
