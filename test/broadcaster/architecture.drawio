<mxCell id="51" value="竞争点：入队 / 取批时的短临界区。&#xa;批量摊薄锁操作，通知可合并；并非无锁。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#f5f5f5;strokeColor=#999999;spacing=8;fillColor=none;strokeColor=none;align=left;fontSize=17;" vertex="1" parent="38"><mxGeometry x="25" y="785" width="420" height="70" as="geometry"/></mxCell>
<mxCell id="52" value="共同约束" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#f5f5f5;strokeColor=#999999;spacing=8;fillColor=none;strokeColor=none;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="1070" width="160" height="35" as="geometry"/></mxCell>
<mxCell id="53" value="每目标容量相同，计入排队、已取出的批次和正在处理的投递；源停止后排空队列，再退出 worker。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#f5f5f5;strokeColor=#999999;spacing=8;fillColor=none;strokeColor=none;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry x="200" y="1070" width="1280" height="35" as="geometry"/></mxCell>
<mxCell id="54" value="多资源扩展" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#f5f5f5;strokeColor=#999999;spacing=8;fillColor=none;strokeColor=none;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="1120" width="160" height="35" as="geometry"/></mxCell>
<mxCell id="55" value="target % Resources 决定输出归属；后两种为每个资源各建一组 queue + worker。不同资源可并行，同一资源内串行。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#f5f5f5;strokeColor=#999999;spacing=8;fillColor=none;strokeColor=none;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry x="200" y="1120" width="1280" height="35" as="geometry"/></mxCell>
<mxCell id="56" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#f5f5f5;strokeColor=#999999;spacing=8;container=1;pointerEvents=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="1180" width="1440" height="50" as="geometry"/></mxCell>
<mxCell id="57" value="执行单元" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=8;" vertex="1" parent="56"><mxGeometry x="0" y="0" width="190" height="40" as="geometry"/></mxCell>
<mxCell id="58" value="队列" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#fff2cc;strokeColor=#d6b656;spacing=8;" vertex="1" parent="56"><mxGeometry x="220" y="0" width="190" height="40" as="geometry"/></mxCell>
<mxCell id="59" value="输出锁竞争" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#f8cecc;strokeColor=#b85450;spacing=8;" vertex="1" parent="56"><mxGeometry x="440" y="0" width="190" height="40" as="geometry"/></mxCell>
<mxCell id="60" value="输出资源" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#d5e8d4;strokeColor=#82b366;spacing=8;" vertex="1" parent="56"><mxGeometry x="660" y="0" width="190" height="40" as="geometry"/></mxCell>
<mxCell id="61" value="公共约束" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#f5f5f5;strokeColor=#999999;spacing=8;" vertex="1" parent="56"><mxGeometry x="880" y="0" width="190" height="40" as="geometry"/></mxCell>
<mxCell id="62" value="实验观察：共享输出突发负载 CPU 中位数 44.5% → 28.2% → 21.3%（100% = 一核）。&#xa;这是抽象测试，不含网络和加密；更低 CPU 不代表所有延迟、丢弃指标都更好。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#20252b;fillColor=#f5f5f5;strokeColor=#999999;spacing=8;fillColor=none;strokeColor=none;align=left;fontSize=17;" vertex="1" parent="1"><mxGeometry x="30" y="1250" width="1440" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
